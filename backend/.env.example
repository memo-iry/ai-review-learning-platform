# Supabase PostgreSQL (Session pooler)
# 접속은 Session pooler(5432)만 사용한다.
#   Direct connection    IPv6 전용이라 국내 망에서 연결되지 않는다
#   Transaction pooler   6543. Hibernate 의 prepared statement 와 충돌한다

DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.whvadgfunkpmllizweom
DB_PASSWORD=
# openai 프로파일로 실행할 때만 필요합니다.
# 기본 프로파일은 규칙 기반 분석기를 쓰므로 비워 두어도 동작합니다.
OPENAI_API_KEY=
